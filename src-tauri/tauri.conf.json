{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkdown",
  "mainBinaryName": "inkdown",
  "version": "1.0.10",
  "identifier": "com.inkdown.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "node tools/build-ui.mjs --dev",
    "beforeBuildCommand": "node tools/build-ui.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Inkdown",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#101014",
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
